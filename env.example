# 复制为 .env 后填写（.env 不会进 git）
# Discord 开发者后台 → 你的应用 → OAuth2 页面
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot 页面 → Reset Token（机器人负责夜里闭麦、拉人进私聊语音）
DISCORD_TOKEN=
PORT=3001
# 设为 1 时可以直接用普通浏览器打开 http://localhost:3001/?name=小明 测试（上线时请关掉）
DEV_LOGIN=1

# AI 房主配音（可选）：Azure 语音服务 → 你的语音资源 → 密钥和终结点
# 不填就用各人设备自带的语音
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# 声音和语气（云枫可选 serious / depressed / sad / fearful / angry / cheerful / disgruntled，留空 = 不加语气）
AZURE_TTS_VOICE=zh-CN-YunfengNeural
AZURE_TTS_STYLE=depressed
AZURE_TTS_RATE=-8%
AZURE_TTS_PITCH=-4%

# 造谣者（黯月初升）的自由声明交给 AI 判真假（可选，都不填就只能用固定句式）
# 先问 OpenRouter 上的 Jev（typesafe/jev-router），判不准或失败再问 DeepSeek，最后 DeepSeek 快速模型；模型都可以不填，用默认的
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-router
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# 快速模型可以用另一把 key，不填就用上面那把
DEEPSEEK_FAST_API_KEY=
DEEPSEEK_FAST_MODEL=deepseek-flash
